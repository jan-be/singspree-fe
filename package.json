    "react-use-measure": "^2.1.7",
    "react-youtube": "^10.1.0",
    "seedrandom": "^3.0.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "onnxruntime-node": "1.30.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.5"
  },
  "trustedDependencies": [
    "onnxruntime-node",
    "protobufjs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run prerender",
    "prerender": "vite build --ssr src/prerender/render.tsx --outDir .prerender --logLevel warn && bun .prerender/render.js",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.bench.json",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:stress": "playwright test e2e/stress.spec.ts --project=chromium"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
